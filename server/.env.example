# CineBook Server Environment Configuration Example
# Copy this file to server/.env and fill in secure values for deployment.

# Server Port (default 4000)
PORT=4000

# Strong production JWT Secret (minimum 32 characters, cryptographically random)
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_at_least_32_characters

# Client Origin allowed by CORS (e.g., http://localhost:5173 or your production domain)
CLIENT_ORIGIN=http://localhost:5173

# Node Environment: 'development' or 'production'
NODE_ENV=development

